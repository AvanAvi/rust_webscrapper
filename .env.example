# Throwaway credentials for the local development Postgres (docker-compose.dev.yml).
# scripts/dev-db.sh copies this file to .env (gitignored) on first use. These are not secrets:
# the database listens on 127.0.0.1 only and must never hold real data.
POSTGRES_USER=proofcrawl
POSTGRES_PASSWORD=proofcrawl-dev-only
POSTGRES_DB=proofcrawl
# Host port on 127.0.0.1. 55432 avoids clashing with a native Postgres on 5432.
DEV_DB_PORT=55432
